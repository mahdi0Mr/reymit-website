generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Ticket {
  id              String        @id @default(cuid())
  trackingId      String        @unique @default(uuid())
  email           String
  contactInfo     String
  title           String
  content         String        @db.Text
  imageUrl        String?       // [جدید] URL عکس پیوست شده به تیکت اصلی (اختیاری)
  status          String        @default("OPEN")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  replies         TicketReply[]
}

model TicketReply {
  id            String   @id @default(cuid())
  content       String   @db.Text
  imageUrl      String?  // [جدید] URL عکس پیوست شده به پاسخ (اختیاری)
  createdAt     DateTime @default(now())
  authorIsAdmin Boolean
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id])
}

model AppFile {
  id           String    @id @default(cuid())
  version      String    @unique
  fileName     String
  url          String
  changelog    String    @db.Text
  releaseDate  DateTime  @default(now())
}

// [جدید] وضعیت نسخه‌های در حال اجرای برنامه کنترلر دونیت
// توسط اپلیکیشن از طریق POST /api/app-status ثبت می‌شود
model AppStatus {
  machineId        String   @id // شناسه دستگاه (md5 کاربر@کامپیوتر از سمت اپ)
  computerName     String   // نام کامپیوتر
  online           Boolean  @default(true) // گزارش اپ: آنلاین/آفلاین
  runningForStream Boolean  @default(false) // گزارش اپ: آیا پایش استریم فعال است
  appVersion       String?  // نسخه برنامه
  platform         String?  // پلتفرم انتخاب‌شده (reymit / donito)
  lastSeenAt       DateTime @default(now()) // زمان دریافت آخرین heartbeat (ساعت سرور)
  updatedAt        DateTime @updatedAt

  // [جدید] جزئیات پیشرفته (رمزنگاری‌شده از سمت اپ)
  windowTarget       String? // اسم پنجره هدف (plaintext — غیرحساس)
  platformTokenEnc   String? // JSON رمزنگاری‌شده از توکن‌های API
  donationLogEnc     String? // آرایه رمزنگاری‌شده از دونیت‌ها
  appLogEnc          String? // متن کامل لاگ برنامه (رمزنگاری‌شده)
}

// [جدید] پیام‌های ارسالی از سمت مدیریت به برنامه‌ها
// اگر machineId null باشد یعنی پیام برای همه دستگاه‌ها (broadcast) است
model AppMessage {
  id         String    @id @default(cuid())
  machineId  String?   // null = broadcast برای همه دستگاه‌ها
  message    String    @db.Text // متن پیام
  createdAt  DateTime  @default(now()) // زمان ارسال
  readAt     DateTime? // زمانی که برنامه دریافت پیام را تأیید کرد
}

// [جدید] ادمین‌های پنل مدیریت (سیستم چند ادمینه)
model Admin {
  id           String       @id @default(cuid())
  username     String       @unique
  password     String       // bcrypt hashed
  nickname     String       // نام نمایشی
  isActive     Boolean      @default(true)
  isSuperAdmin Boolean      @default(false) // ادمین کامل — همه منوها و دسترسی‌ها
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  permissions  Permission[]
  auditLogs    AuditLog[]
  licenses     GeneratedLicense[]
}

// [جدید] دسترسی‌های هر ادمین (سیستم نقش با مجوزهای دلخواه)
model Permission {
  id       String @id @default(cuid())
  adminId  String
  admin    Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action   String // e.g. "manage_admins", "view_status", "send_messages", ...
  @@unique([adminId, action])
}

// [جدید] تاریخچه فعالیت‌های ادمین‌ها
model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  action    String   // e.g. "login", "upload_version", "create_admin", "generate_license"
  details   String?  // JSON با جزئیات بیشتر
  ip        String?
  createdAt DateTime @default(now())
}

// [جدید] لایسنس‌های تولید شده در سایت
model GeneratedLicense {
  id         String     @id @default(cuid())
  machineId  String
  licenseKey String     @unique
  expiryDate DateTime
  revoked    Boolean    @default(false)
  revokedAt  DateTime?
  adminId    String?
  admin      Admin?     @relation(fields: [adminId], references: [id])
  createdAt  DateTime   @default(now())
}

// [جدید] تنظیمات زمان‌بندی برنامه (تک رکورد سراسری)
// این تنظیمات از پنل ادمین قابل تغییر است و اپلیکیشن در heartbeat دریافت می‌کند
model MachineConfig {
  id                     String   @id @default(cuid())
  messageCheckInterval   Int      @default(60)     // فاصله بررسی پیام‌های مدیریت (ثانیه)
  statusUpdateInterval   Int      @default(60)     // فاصله ارسال heartbeat (ثانیه)
  versionCheckInterval   Int      @default(600)    // فاصله بررسی آپدیت جدید (ثانیه) - پیش‌فرض ۱۰ دقیقه
  donationPollInterval   Int      @default(5)      // فاصله دریافت دونیت از API (ثانیه)
  updatedAt              DateTime @updatedAt
}

// [جدید] تاریخچه کامل تغییرات هر دستگاه
// هم از سمت اپ (وضعیت آنلاین/استریم) و هم از سمت ادمین (لایسنس/تنظیمات) ثبت می‌شود
model MachineLog {
  id        String   @id @default(cuid())
  machineId String
  action    String   // online, offline, stream_start, stream_stop, license_assigned, license_revoked, donation_received, config_changed, admin_message_sent, license_reinstated
  details   String?  // JSON payload
  source    String   @default("app") // "app" | "admin"
  createdAt DateTime @default(now())

  @@index([machineId, createdAt])
}

// [جدید] تنظیمات زمان‌بندی اختصاصی هر دستگاه
// همه فیلدها اختیاری‌اند؛ فیلد خالی/null یعنی از تنظیمات سراسری (MachineConfig) استفاده شود
model MachineConfigOverride {
  machineId            String   @id
  messageCheckInterval Int? // null = از تنظیمات سراسری
  statusUpdateInterval Int? // null = از تنظیمات سراسری
  versionCheckInterval Int? // null = از تنظیمات سراسری
  donationPollInterval Int? // null = از تنظیمات سراسری
  updatedAt            DateTime @updatedAt
}

// [جدید] کاتالوگ سراسری پلتفرم‌های API (قالب هر پلتفرم)
// اپلیکیشن با همین تنظیمات بدون کد اختصاصی، دونیت‌ها را از هر API دریافت می‌کند
model ApiPlatform {
  id           String   @id @default(cuid())
  key          String   @unique // شناسه پایدار: "reymit" | "donito" | دلخواه
  displayName  String   // نام نمایشی (فارسی) در اپلیکیشن
  apiUrl       String   // آدرس API — توکن با {token} جایگزین می‌شود
  listPath     String   @default("data") // مسیر نقطه‌ای رسیدن به آرایه دونیت‌ها، مثال: "data" یا "data.data"
  idField      String   @default("id")
  nameField    String   @default("name")
  amountField  String   @default("amount")
  amountUnit   String   @default("toman") // "toman" | "rial" — اپ به تومان نرمال می‌کند
  advancedJson String?  // JSON اختیاری (مثلاً header ها) — ادغام و ارسال به اپ
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  machineLinks MachinePlatform[]
}

// [جدید] پیوند هر دستگاه به پلتفرم‌های کاتالوگ (فعال‌سازی per-machine)
model MachinePlatform {
  id         String     @id @default(cuid())
  machineId  String
  platformId String
  enabled    Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  platform   ApiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([machineId, platformId])
  @@index([machineId])
}